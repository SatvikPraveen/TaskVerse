{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "incremental": false,
    "noUnusedLocals": true,
    "jsx": "preserve"
  },
  "include": ["benchmarks/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
