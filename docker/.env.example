# docker/.env.example — copy to docker/.env and fill in the secrets.

# MongoDB
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=change-me
MONGODB_DATABASE=taskverse

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=taskverse-files

# JWT — at least 32 characters each; generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origins allowed to call the API (comma separated). The web container is served on 8080.
ALLOWED_ORIGINS=http://localhost:8080

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
