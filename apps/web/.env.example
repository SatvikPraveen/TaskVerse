# apps/web/.env.example — copy to apps/web/.env for local development.

# Leave empty to use the Vite dev-server proxy (same origin). Set to an absolute
# URL when the API runs elsewhere.
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Where the dev-server proxy forwards /api and /socket.io
VITE_PROXY_TARGET=http://localhost:3001
