{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": true,
    "incremental": false,
    "jsx": "preserve"
  },
  "include": ["index.ts", "zod/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
